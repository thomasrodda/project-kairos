# .env.example

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/project_kairos_dev"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Firebase Configuration (Frontend)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK (Backend)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# API Configuration
VITE_API_URL=http://localhost:3001
NODE_ENV=development

# Optional: AI Services (for future features)
OPENAI_API_KEY=your-openai-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-pinecone-environment

# Development Settings
LOG_LEVEL=debug
ENABLE_QUERY_LOGGING=true

# Security Configuration
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000  # 1 minute in milliseconds
AUTH_RATE_LIMIT_MAX_REQUESTS=20
FILE_UPLOAD_RATE_LIMIT_WINDOW_MS=3600000  # 1 hour in milliseconds
FILE_UPLOAD_RATE_LIMIT_MAX_REQUESTS=10

# Request Size Limits
JSON_SIZE_LIMIT=10mb
URL_ENCODED_SIZE_LIMIT=10mb
RAW_SIZE_LIMIT=50mb

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000

# Content Security Policy
CSP_ENABLED=true

# Session Security
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE=86400000  # 24 hours in milliseconds

# JWT Security (if using JWT)
JWT_SECRET=change-this-to-a-long-random-jwt-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# IP Blocking
IP_BLOCKING_ENABLED=false
BLOCKED_IPS=  # Comma-separated list of IPs to block

# Security Logging
SECURITY_LOGGING_ENABLED=true
SECURITY_LOG_LEVEL=info  # Options: error, warn, info, debug

# Phase 3 Services Configuration

# History Service
HISTORY_SNAPSHOT_THRESHOLD=100  # Create snapshot every N changes
HISTORY_SNAPSHOT_INTERVAL_HOURS=24  # Create snapshot every N hours
HISTORY_RETENTION_DAYS=30  # Keep history for N days (free tier default)
HISTORY_QUERY_LIMIT_MAX=100  # Maximum number of history items per query
HISTORY_QUERY_LIMIT_DEFAULT=50  # Default number of history items per query

# Search Service
SEARCH_QUERY_MAX_LENGTH=200  # Maximum length of search query
SEARCH_RESULT_LIMIT_MAX=100  # Maximum number of search results
SEARCH_RESULT_LIMIT_DEFAULT=20  # Default number of search results
SEARCH_SUGGESTION_LIMIT=5  # Number of search suggestions
SEARCH_CONTEXT_LENGTH=200  # Length of search result context snippet
SEARCH_CONTEXT_PREVIEW=50  # Context preview around first match

# Export Service
EXPORT_MAX_SIZE_MB=50  # Maximum export size in MB
EXPORT_MAX_RECURSION_DEPTH=10  # Maximum depth for recursive subpage exports
EXPORT_INCLUDE_METADATA=false  # Include metadata in exports by default
EXPORT_INCLUDE_SUBPAGES=true  # Include subpages in exports by default

# Sync Service
SYNC_ACTIVE_EDIT_TTL=30  # TTL for active edits in seconds
SYNC_STALE_EDIT_THRESHOLD=60  # Threshold for considering edits as stale (seconds)
SYNC_CLEANUP_INTERVAL_MINUTES=5  # Cleanup interval in minutes

# WebSocket Configuration
WEBSOCKET_CORS_ORIGINS=http://localhost:3000  # Comma-separated list of allowed origins
WEBSOCKET_PING_TIMEOUT=60000  # Ping timeout in milliseconds
WEBSOCKET_PING_INTERVAL=25000  # Ping interval in milliseconds
WEBSOCKET_EVENTS_PER_MINUTE=120  # Maximum events per minute per socket
WEBSOCKET_BROADCASTS_PER_MINUTE=60  # Maximum broadcasts per minute per socket