#!/bin/sh
# .husky/pre-commit

# Update FILE_TREE.md before commit (if tree command is available)
if command -v tree >/dev/null 2>&1; then
  echo "🌳 Updating FILE_TREE.md..."

  tree -L 8 \
       -I 'node_modules|dist|build|coverage|.turbo|.next|.vercel|*.log' \
       --dirsfirst --noreport -a --charset utf8 \
       .claude .github .husky .vscode "AI System Prompt Files" apps packages prisma \
       > FILE_TREE.md

  git add FILE_TREE.md
fi

# Run lint-staged for code quality checks
echo "🧹 Running lint-staged..."
yarn lint-staged

# Run type checking
echo "🔍 Running type checks..."
yarn typecheck

# Prompt before running tests (using /dev/tty for interactive input)
echo "🧪 Do you want to run tests before commit? (y/n): "
read run_tests < /dev/tty

if [ "$run_tests" = "y" ] || [ "$run_tests" = "Y" ]; then
  echo "🧪 Running tests..."
  yarn test --passWithNoTests --bail
else
  echo "⚠️ Skipping tests on commit."
fi
