{
  "name": "project-kairos",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @kairos/web dev\" \"yarn workspace @kairos/api dev\" --names \"web,api\" --prefix-colors \"blue,green\"",
    "build": "yarn workspaces foreach -A run build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --fix && yarn lint:styles --fix",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx && yarn lint:styles",
    "lint:styles": "stylelint '**/*.{scss,css}' --ignore-path .gitignore",
    "lint:styles:fix": "stylelint '**/*.{scss,css}' --ignore-path .gitignore --fix",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:golden": "jest apps/web/src/tests/golden-files/editor-golden.test.tsx",
    "test:golden:update": "UPDATE_GOLDEN=true jest apps/web/src/tests/golden-files/editor-golden.test.tsx",
    "test:coverage:web": "cd apps/web && jest --coverage src/utils src/hooks",
    "test:coverage:api": "cd apps/api && jest --coverage",
    "test:coverage:report": "yarn test:coverage:web && yarn test:coverage:api",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,scss,css}\"",
    "postinstall": "chmod +x ./fix-permissions.sh && ./fix-permissions.sh && husky",
    "prepare": "husky",
    "update-tree": "tree -L 8 -I 'node_modules|dist|build|coverage|.turbo|.next|.vercel|*.log' -F --dirsfirst --charset ascii --noreport -a .claude .github .husky .vscode \"AI System Prompt Files\" apps packages prisma > FILE_TREE.md",
    "db:migrate": "dotenv -e .env.local -- yarn workspace @kairos/database db:migrate",
    "db:deploy": "dotenv -e .env.local -- yarn workspace @kairos/database db:deploy",
    "db:reset": "dotenv -e .env.local -- yarn workspace @kairos/database db:reset",
    "db:seed": "dotenv -e .env.local -- yarn workspace @kairos/database db:seed",
    "db:studio": "dotenv -e .env.local -- yarn workspace @kairos/database db:studio",
    "db:generate": "dotenv -e .env.local -- yarn workspace @kairos/database generate",
    "db:push": "dotenv -e .env.local -- yarn workspace @kairos/database db:push",
    "setup": "chmod +x ./setup.sh && ./setup.sh",
    "kill-ports": "./kill-ports.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cssnano": "^7.0.7",
    "cypress": "^14.4.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "pg": "^8.16.3",
    "postcss": "^8.5.3",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-declaration-strict-value": "^1.10.6",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.9.2",
  "dependencies": {
    "react-dom": "^19.1.0"
  }
}
